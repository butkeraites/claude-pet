# Copie para .env se quiser mudar algo. Tudo tem padrão.

# Dono do socket do Wayland e do diretório hypr/ (tem que ser o seu usuário).
APP_UID=1000
APP_GID=1000

# Porta no loopback onde os hooks do Claude Code entregam os eventos.
# Se mudar, exporte PET_PORTA com o mesmo valor no ambiente do Claude Code.
PET_PORTA=27380

# error | warn | info | debug
PET_LOG=info
