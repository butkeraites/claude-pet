# Compilação
/target/

# Configuração e segredos locais
.env
/config/bichinho.toml
/config/claude-pet.toml

# Arte que não pode ser redistribuída (decisão 0011)
/skins-locais/*
!/skins-locais/.gitkeep
# Relatório de `cargo xtask cobertura` (gerado, não vai para o git)
/skins/*/cobertura.md

# Saídas temporárias (fotos, prévias, capturas; a saída do gerador da arte
# livre vai para tmp/zeca-livre/)
/tmp/
/previa/
# Cache do Python, se alguém importar o arte/zeca-livre/zeca.py
__pycache__/

# Editores
*.swp
*~
.idea/
.vscode/
