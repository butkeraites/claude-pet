<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike descartável (M8 Windows): prova que um runner windows-latest do
       GitHub Actions tem desktop visível e que dá pra tirar screenshot — o
       "Mac virtual" para conferir o overlay do Windows automaticamente. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
</Project>
