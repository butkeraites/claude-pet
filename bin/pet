#!/usr/bin/env bash
# bin/pet — atalhos de desenvolvimento do bichinho. `bin/pet ajuda` lista os
# comandos.
#
# Funciona de qualquer pasta (resolve a raiz do repo pelo próprio caminho)
# e acrescenta ~/.cargo/bin ao PATH, que fica fora do PATH do Renan.
set -euo pipefail

RAIZ="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# Caminhos relativos dados pelo usuário são relativos a onde ele estava.
ORIGEM="$PWD"
cd "$RAIZ"
export PATH="$HOME/.cargo/bin:$PATH"

# Porta dos hooks: ambiente > .env > padrão.
porta_configurada() {
  if [ -n "${PET_PORTA:-}" ]; then
    printf '%s' "$PET_PORTA"
  elif [ -f .env ] && grep -qE '^PET_PORTA=' .env; then
    grep -E '^PET_PORTA=' .env | tail -n1 | cut -d= -f2-
  else
    printf '27380'
  fi
}
PORTA="$(porta_configurada)"
URL="http://127.0.0.1:${PORTA}"

ajuda() {
  cat <<'TEXTO'
uso: bin/pet <comando>

  subir           sobe o pet (docker compose up -d --build), com o commit da
                  árvore na imagem; na primeira vez depois do nome novo,
                  aposenta o container claude-pet antigo (o volume com a
                  aprovação fica)
  parar           para o pet
  logs            acompanha os logs
  estado          mostra /v1/estado (o que o pet está vendo e pensando)
  instalar-host [--da-branch]
                  copia o binário estático da imagem para ~/.local/bin/bichinho
                  (o hook do plugin chama `bichinho avisar`; PET_BIN_HOST muda
                  a pasta). Só aceita a imagem do commit da worktree estável
                  (sem ela, o da main) e de árvore limpa: o hook vale para todas
                  as sessões do Claude Code. --da-branch pula a conferência
                  (só para uma pasta fora do PATH, nos testes)
  simular <nome|arquivo>
                  roda um cenário (cenarios/<nome>.jsonl, ou o arquivo) no
                  cérebro e no Motor num relógio falso, offline, e imprime a
                  linha do tempo das intenções (o bichinho da branch: PET_BICHINHO
                  ou o cargo)
  eventos [--salvar <arquivo>]
                  os eventos que um pet de debug recebeu (/v1/debug/eventos;
                  só metadados); --salvar grava um cenário com pseudônimos
                  (s1, p1, a1, projeto-a) no arquivo. Recusa um pet sem debug
                  (a produção nunca guarda eventos)
  testar CENÁRIO  manda eventos sintéticos pelo hook de verdade (o `bichinho
                  avisar` do PATH, ou PET_BICHINHO; sem ele, o avisar.sh de
                  reserva), com PET_TESTE=1 (isolados das sessões reais e
                  esquecidos em 60 s), e mostra a reação e o que a tela fez:
                  rapido → nod, pequeno → done_small, medio → done_medium
                  (T2, confete), grande → done_big (T3, chuva; o segundo em
                  10 min vira T2), pergunta → a chamada e o aceno,
                  dois-prontos → uma festa só
  tocar REAÇÃO    toca uma reação (nod, done_small, wave, alert, …) e diz a
                  tag que a skin tocou e se ela apareceu na tela
  clique [esquerdo|direito]
                  clica no pet como o mouse e mostra o que ele fez: focou o
                  terminal da sessão do aviso mais urgente, mostrou o balão
                  (com o porquê de não focar) ou a lista das sessões, ou a
                  soneca (direito)
  esconder        esconde o pet (até mostrar ou reiniciar)
  mostrar         mostra o pet de novo
  foto            foto do pet na tela (grim no monitor inteiro, recorte exato;
                  em debug, só os pixels do pet sobre fundo neutro)
  skin-instalar <zip|pasta>
                  instala o Zeca a partir do pack Cute Parrots! (lê o zip em
                  memória, gera skins-locais/zeca e zeca-contorno, mostra
                  lint, cobertura e as prévias em tmp/previa-zeca-m2/)
  skin-livre      refaz o Zeca original (arte livre, CC0) em skins/zeca-livre e
                  zeca-livre-escuro a partir do gerador arte/zeca-livre/zeca.py,
                  com lint, cobertura e as prévias em tmp/previa-zeca-livre/
  skin-aprovar [id]
                  aprova o personagem que você viu na folha de contato
                  (padrão: a skin configurada); só vale se a skin for a da
                  folha e a imagem tiver exatamente esses arquivos; guarda
                  uma cópia aprovada em /state
  skin-revogar [id]
                  tira a aprovação: o pet volta a ficar escondido
  reconstruir     reconstrói a imagem com bases atualizadas e sobe de novo
  dev             modo desenvolvimento em primeiro plano (debug, sem restart)
  verificar       portão antes de todo commit: fmt, clippy, testes, compose, plugin
  ajuda           esta mensagem
TEXTO
}

# O pet só existe no 127.0.0.1: `-q` (primeiro) ignora todo curlrc e
# `--noproxy '*'` ignora os proxies do ambiente (decisão 0031).
api() {
  curl -q --noproxy '*' -fsS -m 3 -H 'X-Pet: 1' "${URL}$1"
}

# POST /v1/comando, o mesmo para as reações e as aprovações (decisão 0030);
# deixa a resposta em RESPOSTA e o status HTTP em STATUS.
RESPOSTA=""
STATUS=""
comando_pet() {
  local saida
  saida="$(curl -q --noproxy '*' -sS -m 10 -w '\n%{http_code}' -X POST -H 'X-Pet: 1' \
    -H 'Content-Type: application/json' --data-binary "$1" "${URL}/v1/comando")" || return 1
  STATUS="${saida##*$'\n'}"
  RESPOSTA="${saida%$'\n'*}"
}

# esconder e mostrar: o pet responde 204; senão, mostra o motivo que ele
# devolveu.
comando() {
  if ! comando_pet "$1"; then
    echo "o pet não respondeu em ${URL} — está de pé? (bin/pet subir)" >&2
    return 1
  fi
  if [ "$STATUS" != 204 ]; then
    printf 'o pet recusou (%s): %s\n' "$STATUS" \
      "$(jq -r '.erro // empty' <<<"$RESPOSTA" 2>/dev/null || true)" >&2
    return 1
  fi
}

# tocar <reação>: o pet toca e responde o que fez (decisão 0033): 200 com a
# tag e se ela apareceu na tela (sem compositor ou escondido, não aparece:
# sai 1); 409 sem personagem aprovado; 400 se a skin não sabe tocar.
tocar_reacao() {
  if ! comando_pet "$(jq -nc --arg r "$1" '{cmd: "tocar", arg: $r}')"; then
    echo "o pet não respondeu em ${URL} — está de pé? (bin/pet subir)" >&2
    return 1
  fi
  if [ "$STATUS" != 200 ]; then
    printf 'o pet recusou (%s): %s\n' "$STATUS" \
      "$(jq -r '.erro // empty' <<<"$RESPOSTA" 2>/dev/null || true)" >&2
    return 1
  fi
  local tag
  tag="$(jq -r .tag <<<"$RESPOSTA")"
  if [ "$(jq -r .tocou <<<"$RESPOSTA")" = true ]; then
    printf 'tocou «%s» (tag %s)\n' "$1" "$tag"
  else
    printf '«%s» não apareceu: %s (tag %s)\n' "$1" "$(jq -r .motivo <<<"$RESPOSTA")" "$tag" >&2
    return 1
  fi
}

# clique [esquerdo|direito]: o pet clica em si mesmo como o ponteiro
# (decisão 0057) e responde o que fez, em JSON: `focou` (o endereço da janela
# e se o desktop já confirmou), `balao` (o porquê de não focar), `lista` ou
# `soneca`. Sem compositor, `nada`.
clicar_no_pet() {
  local botao="${1:-esquerdo}"
  case "$botao" in
    esquerdo | direito) ;;
    *)
      echo "uso: bin/pet clique [esquerdo|direito]" >&2
      return 2
      ;;
  esac
  if ! comando_pet "$(jq -nc --arg b "$botao" '{cmd: "clique", arg: $b}')"; then
    echo "o pet não respondeu em ${URL} — está de pé? (bin/pet subir)" >&2
    return 1
  fi
  if [ "$STATUS" != 200 ]; then
    printf 'o pet recusou (%s): %s\n' "$STATUS" \
      "$(jq -r '.erro // empty' <<<"$RESPOSTA" 2>/dev/null || true)" >&2
    return 1
  fi
  jq -c . <<<"$RESPOSTA"
}

# O commit desta árvore, para a imagem saber de onde saiu (decisão 0045):
# `git rev-parse HEAD`, com `-sujo` se há mudanças (arquivos novos contam; os
# ignorados, como config/bichinho.toml, não).
fonte_do_clone() {
  local commit
  commit="$(git rev-parse HEAD 2>/dev/null || true)"
  if [ -z "$commit" ]; then
    printf 'desconhecida'
    return
  fi
  if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    commit="${commit}-sujo"
  fi
  printf '%s' "$commit"
}

# O hook que o plugin chama (decisão 0041): o `bichinho` do PATH, como o
# O bichinho da branch, para os subcomandos que o do PATH (o da worktree
# estável) pode não ter: PET_BICHINHO, ou o cargo.
bichinho_da_branch() {
  if [ -n "${PET_BICHINHO:-}" ]; then
    "$PET_BICHINHO" "$@"
  else
    cargo run -q -p bichinho -- "$@"
  fi
}

# Um caminho que o usuário deu, relativo a onde ele estava.
caminho_do_usuario() {
  case "$1" in
    /*) printf '%s' "$1" ;;
    *) printf '%s' "$ORIGEM/$1" ;;
  esac
}

# bin/pet simular <nome|arquivo>: o cenário pelo nome (cenarios/<nome>.jsonl)
# ou pelo arquivo, no relógio falso (decisão 0078).
simular() {
  local alvo="${1:-}" arquivo
  if [ -z "$alvo" ] || [ "$#" -gt 1 ]; then
    echo "uso: bin/pet simular <nome|arquivo.jsonl>" >&2
    return 2
  fi
  if [ -f "$(caminho_do_usuario "$alvo")" ]; then
    arquivo="$(caminho_do_usuario "$alvo")"
  elif [ -f "cenarios/${alvo}.jsonl" ]; then
    arquivo="$RAIZ/cenarios/${alvo}.jsonl"
  else
    echo "não achei o cenário «${alvo}» (nem o arquivo, nem cenarios/${alvo}.jsonl)" >&2
    return 1
  fi
  bichinho_da_branch simular "$arquivo"
}

# bin/pet eventos [--salvar <arquivo>]: o /v1/debug/eventos do pet da
# PET_PORTA; com --salvar, o cenário com pseudônimos (decisão 0078). Só de um
# pet de debug: a produção não guarda eventos, e a recusa vem antes de pedir.
eventos() {
  local destino=""
  case "${1:-}" in
    "") ;;
    --salvar)
      destino="${2:-}"
      if [ -z "$destino" ] || [ "$#" -gt 2 ]; then
        echo "uso: bin/pet eventos [--salvar <arquivo.jsonl>]" >&2
        return 2
      fi
      ;;
    *)
      echo "uso: bin/pet eventos [--salvar <arquivo.jsonl>]" >&2
      return 2
      ;;
  esac
  local estado
  if ! estado="$(api /v1/estado)"; then
    echo "o pet não respondeu em ${URL} — está de pé?" >&2
    return 1
  fi
  if [ "$(jq -r '.debug' <<<"$estado")" != true ]; then
    echo "o pet em ${URL} não está em debug: só um pet de debug (PET_DEBUG=1, a pilha de dev ou um de rascunho na PET_PORTA) guarda os eventos; a produção nunca guarda" >&2
    return 1
  fi
  local json
  if ! json="$(api /v1/debug/eventos)"; then
    echo "o pet em ${URL} não deu os eventos (/v1/debug/eventos)" >&2
    return 1
  fi
  if [ -z "$destino" ]; then
    jq . <<<"$json"
    return
  fi
  local arquivo nome temporario
  arquivo="$(caminho_do_usuario "$destino")"
  nome="$(basename "$arquivo" .jsonl)"
  temporario="$(mktemp "${arquivo}.XXXXXX")"
  if ! bichinho_da_branch cenario "$nome" <<<"$json" >"$temporario"; then
    rm -f "$temporario"
    return 1
  fi
  mv "$temporario" "$arquivo"
  echo "✓ $(grep -c '"evento"' "$arquivo") eventos em ${destino}, com pseudônimos (s1, p1, a1, projeto-a); confira antes de pôr no git"
}

# Claude Code acha no exec form, ou PET_BICHINHO; vazio se não houver.
binario_do_hook() {
  if [ -n "${PET_BICHINHO:-}" ]; then
    printf '%s' "$PET_BICHINHO"
  else
    command -v bichinho 2>/dev/null || true
  fi
}

# Um cenário sintético PELO hook de verdade, como o Claude Code chamaria: o
# JSON do hook na entrada padrão, CLAUDE_CODE_ENTRYPOINT=cli (uma sessão de
# terminal) e PET_TESTE=1 (o pet isola o evento das sessões reais e o esquece
# em 60 s). O hook é o `bichinho avisar` (o do PATH ou PET_BICHINHO); sem ele,
# o avisar.sh de reserva, com aviso. Depois espera a acomodação do Stop e
# mostra a reação, o nível e o que a tela fez (o /v1/estado: o turno, as
# intenções e o desenho; decisão 0087).
HOOK_NATIVO=""
hook_de_teste() {
  # hook_de_teste <sid> <turno> <pasta> <Evento> <json a mais>
  jq -nc --arg e "$4" --arg sid "$1" --arg turno "$2" --arg cwd "$3" --argjson extra "$5" \
    '{session_id: $sid, prompt_id: $turno, cwd: $cwd,
      transcript_path: "/dev/null", hook_event_name: $e} + $extra' |
    if [ -n "$HOOK_NATIVO" ]; then
      PET_TESTE=1 PET_PORTA="$PORTA" CLAUDE_CODE_ENTRYPOINT=cli "$HOOK_NATIVO" avisar "$4"
    else
      PET_TESTE=1 PET_PORTA="$PORTA" CLAUDE_CODE_ENTRYPOINT=cli \
        sh "$RAIZ/plugin/scripts/avisar.sh" "$4"
    fi
}

id_de_teste() {
  od -An -N8 -tx1 /dev/urandom | tr -d ' \n'
}

# Um turno de teste inteiro, com `bash_ms` de Bash e uma edição (0: nenhuma
# ferramenta): o prompt, as ferramentas e o Stop.
turno_de_teste() {
  local sid=$1 turno=$2 cwd=$3 bash_ms=$4
  hook_de_teste "$sid" "$turno" "$cwd" SessionStart '{"source": "startup"}'
  hook_de_teste "$sid" "$turno" "$cwd" UserPromptSubmit '{"prompt": "teste do bin/pet", "source": "user"}'
  if [ "$bash_ms" -gt 0 ]; then
    hook_de_teste "$sid" "$turno" "$cwd" PostToolUse "{\"tool_name\": \"Edit\", \"duration_ms\": 40,
      \"tool_input\": {\"file_path\": \"$cwd/oi.txt\"}, \"tool_response\": {}}"
    hook_de_teste "$sid" "$turno" "$cwd" PostToolUse "{\"tool_name\": \"Bash\", \"duration_ms\": $bash_ms,
      \"tool_input\": {\"command\": \"true\"}, \"tool_response\": {}}"
  fi
  hook_de_teste "$sid" "$turno" "$cwd" Stop '{"stop_hook_active": false, "background_tasks": []}'
}

# Espera (até 5 s) o filtro do jq dar alguma coisa no /v1/estado, com
# `sid8` como argumento; deixa o resultado em ACHADO. A ultima_reacao não
# serve: é de quem reagiu por último, e uma sessão real pode reagir no meio
# (decisão 0034).
ACHADO=""
esperar_no_estado() {
  local sid8=$1 filtro=$2 estado
  ACHADO=""
  for _ in $(seq 1 50); do
    estado="$(api /v1/estado || true)"
    ACHADO="$(jq -c --arg sid8 "$sid8" "$filtro" <<<"$estado" 2>/dev/null || true)"
    [ -n "$ACHADO" ] && return 0
    sleep 0.1
  done
  return 1
}

# O turno de teste da sessão (com a reação) no /v1/estado.turnos.
# shellcheck disable=SC2016 # programa do jq: $sid8 é dele
FILTRO_TURNO='[.turnos[] | select(.teste == true and .sid8 == $sid8
  and .reacao != null)][0] // empty'

testar() {
  local cenario="${1:-}"
  case "$cenario" in
    rapido | pequeno | medio | grande | pergunta | dois-prontos) ;;
    *)
      echo "uso: bin/pet testar <rapido|pequeno|medio|grande|pergunta|dois-prontos>" >&2
      return 2
      ;;
  esac
  if ! api /v1/estado >/dev/null; then
    echo "o pet não respondeu em ${URL} — está de pé? (bin/pet subir)" >&2
    return 1
  fi
  # Um fim até 3 s depois de outra festa entra nela (decisão 0076): cada
  # demonstração espera a festa de antes passar, para mostrar a sua.
  for _ in $(seq 1 40); do
    [ "$(api /v1/estado | jq -r '.fotografia.festa // empty | .nivel' 2>/dev/null || true)" = "" ] && break
    sleep 0.1
  done
  HOOK_NATIVO="$(binario_do_hook)"
  if [ -n "$HOOK_NATIVO" ]; then
    echo "pelo hook nativo: $HOOK_NATIVO avisar ($("$HOOK_NATIVO" versao 2>/dev/null || echo 'sem versão'))"
  else
    echo "aviso: o bichinho não está no PATH (bin/pet instalar-host); indo pelo avisar.sh de reserva" >&2
  fi
  case "$cenario" in
    pergunta) testar_pergunta ;;
    dois-prontos) testar_dois_prontos ;;
    *) testar_turno "$cenario" ;;
  esac
}

# rapido → nod (T0), pequeno → done_small (T1), medio → done_medium (T2,
# 4 min de Bash), grande → done_big (T3, 12 min de Bash; um segundo T3 de
# teste em 10 min vira T2, como o de verdade).
testar_turno() {
  local cenario=$1 esperado bash_ms sid
  case "$cenario" in
    rapido) esperado=nod bash_ms=0 ;;
    pequeno) esperado=done_small bash_ms=900 ;;
    medio) esperado=done_medium bash_ms=240000 ;;
    *) esperado=done_big bash_ms=720000 ;;
  esac
  sid="$(id_de_teste)-pet-testar"
  turno_de_teste "$sid" "$(id_de_teste)" /tmp/pet-testar "$bash_ms"
  if ! esperar_no_estado "${sid:0:8}" "$FILTRO_TURNO"; then
    echo "✗ ${cenario}: nenhuma reação em 5 s (bin/pet logs; os eventos chegaram?)" >&2
    return 1
  fi
  local turno nome
  turno="$ACHADO"
  jq -c '{reacao, nivel, pontuacao: .pontuacao.total, teto, trabalho, outras, arquivos, subagentes, dur_ms, sid8}' <<<"$turno"
  nome="$(jq -r .reacao <<<"$turno")"
  # O T3 de teste no máximo a cada 10 min (decisão 0074): o segundo vira T2.
  if [ "$cenario" = grande ] && jq -e '.teto | index("intervalo_t3")' <<<"$turno" >/dev/null 2>&1; then
    esperado=done_medium
    echo "(outro T3 de teste há menos de 10 min: este virou T2)"
  fi
  mostrar_tela "${sid:0:8}"
  if [ "$nome" = "$esperado" ]; then
    echo "✓ ${cenario} → ${nome}"
  else
    echo "✗ ${cenario}: esperava ${esperado}, veio ${nome}" >&2
    return 1
  fi
}

# O que a tela fez com a sessão (intenções com o sid8 dela) e o desenho de
# agora, só metadados.
mostrar_tela() {
  local estado
  estado="$(api /v1/estado || true)"
  # shellcheck disable=SC2016 # programa do jq: $sid8 é dele
  jq -c --arg sid8 "$1" '[.intencoes[] | select(.sid8 == $sid8 and
      (.i == "festa" or .i == "festa_mesclada" or .i == "escalada" or .i == "reacao"))
      | del(.ha_ms)] | reverse | .[]' <<<"$estado" 2>/dev/null || true
  jq -c '{desenho}' <<<"$estado" 2>/dev/null || true
}

# pergunta: o AskUserQuestion chama na hora (a chamada, o «!» e o balão; a
# L1 da escalada), a resposta acaba a escalada, e o fim é o aceno (nenhuma
# ferramenta de trabalho).
testar_pergunta() {
  local sid turno
  sid="$(id_de_teste)-pet-testar"
  turno="$(id_de_teste)"
  hook_de_teste "$sid" "$turno" /tmp/pet-testar SessionStart '{"source": "startup"}'
  hook_de_teste "$sid" "$turno" /tmp/pet-testar UserPromptSubmit '{"prompt": "teste do bin/pet", "source": "user"}'
  hook_de_teste "$sid" "$turno" /tmp/pet-testar PreToolUse '{"tool_name": "AskUserQuestion", "tool_input": {}}'
  # shellcheck disable=SC2016 # programa do jq: $sid8 é dele
  if ! esperar_no_estado "${sid:0:8}" '[.sessoes[] | select(.teste == true and .sid8 == $sid8
      and .aviso.tipo == "esperando")][0] // empty'; then
    echo "✗ pergunta: o aviso não abriu em 5 s (bin/pet logs)" >&2
    return 1
  fi
  echo "aviso: $(jq -c '{tipo: .aviso.tipo, espera: .aviso.espera, estado}' <<<"$ACHADO")"
  local estado chamou
  estado="$(api /v1/estado || true)"
  # shellcheck disable=SC2016 # programa do jq: $sid8 é dele
  chamou="$(jq -r --arg sid8 "${sid:0:8}" '[.intencoes[] | select(.i == "reacao" and .sid8 == $sid8
      and .motivo == "aviso")][0].nome // empty' <<<"$estado")"
  mostrar_tela "${sid:0:8}"
  # A resposta: a ferramenta volta, a escalada acaba, e o turno termina.
  hook_de_teste "$sid" "$turno" /tmp/pet-testar PostToolUse '{"tool_name": "AskUserQuestion", "duration_ms": 0, "tool_input": {}, "tool_response": {}}'
  hook_de_teste "$sid" "$turno" /tmp/pet-testar Stop '{"stop_hook_active": false, "background_tasks": []}'
  if ! esperar_no_estado "${sid:0:8}" "$FILTRO_TURNO"; then
    echo "✗ pergunta: nenhuma reação no fim em 5 s" >&2
    return 1
  fi
  local nome
  nome="$(jq -r .reacao <<<"$ACHADO")"
  if [ "$chamou" = alert ] && [ "$nome" = nod ]; then
    echo "✓ pergunta → alert (L1, «${sid:0:8}») → ${nome}"
  else
    echo "✗ pergunta: esperava a chamada (alert) e o aceno (nod), vieram «${chamou:-nada}» e «${nome}»" >&2
    return 1
  fi
}

# dois-prontos: duas sessões de teste terminando juntas viram uma festa só,
# com o balão «2 prontos: demo-api, demo-web» (decisão 0076).
testar_dois_prontos() {
  local a b
  a="$(id_de_teste)-pet-testar"
  b="$(id_de_teste)-pet-testar"
  # Um logo depois do outro: o segundo fim chega bem dentro dos 3 s da festa
  # do primeiro.
  turno_de_teste "$a" "$(id_de_teste)" /tmp/demo-api 900
  turno_de_teste "$b" "$(id_de_teste)" /tmp/demo-web 900
  if ! esperar_no_estado "${a:0:8}" "$FILTRO_TURNO" || ! esperar_no_estado "${b:0:8}" "$FILTRO_TURNO"; then
    echo "✗ dois-prontos: as duas festas não chegaram em 5 s" >&2
    return 1
  fi
  local estado mescladas
  estado="$(api /v1/estado || true)"
  # shellcheck disable=SC2016 # programa do jq: $a e $b são dele
  mescladas="$(jq -c --arg a "${a:0:8}" --arg b "${b:0:8}" '[.intencoes[] |
      select(.i == "festa_mesclada" and (.sid8 == $a or .sid8 == $b))] | length' <<<"$estado")"
  jq -c '[.intencoes[] | select(.i == "balao" and .motivo == "festa") | .linhas[]] | .[0]' <<<"$estado"
  mostrar_tela "${a:0:8}"
  mostrar_tela "${b:0:8}" | grep -v '"desenho"' || true
  if [ "$mescladas" = 1 ] && jq -e '[.intencoes[] | select(.i == "balao" and .motivo == "festa")
      | .linhas[] | select(startswith("2 prontos"))] | length > 0' <<<"$estado" >/dev/null; then
    echo "✓ dois-prontos → uma festa só («2 prontos»)"
  else
    echo "✗ dois-prontos: esperava uma festa mesclada com «2 prontos», vieram ${mescladas:-0}" >&2
    return 1
  fi
}

# O core é puro (CLAUDE.md, decisões 0040 e 0044): nenhuma dependência
# normal, direta ou transitiva, pode ser crate de Wayland, do laço de eventos
# ou de um sistema operacional, em nenhum alvo (`--target all`: um crate só
# do Windows ou do macOS também conta). A exceção é o `libc` que o `sha2`
# puxa pela detecção de CPU (`cpufeatures`) nos alvos aarch64: só ele pode
# depender do `libc`.
core_sem_wayland() {
  local proibidas dependentes
  proibidas="$(cargo tree -p pet-core -e normal --target all --prefix none --quiet |
    grep -iE '^(wayland|smithay|calloop|rustix|signal-hook|nix |windows|objc2|core-foundation|cocoa|x11rb|zbus)' |
    sort -u || true)"
  dependentes="$(cargo tree -p pet-core -e normal --target all --prefix none --quiet -i libc --depth 1 2>/dev/null |
    grep -vE '^libc ' | grep -vE '^cpufeatures ' | sort -u || true)"
  if [ -n "$proibidas" ] || [ -n "$dependentes" ]; then
    printf 'pet-core depende de:\n%s\n' "$proibidas${dependentes:+$'\n'libc por: $dependentes}" >&2
    return 1
  fi
}

# O núcleo, os esboços e o daemon compilam para o Windows e o macOS
# (decisão 0040): `cargo clippy --target …`, que não linka e não pede SDK.
# Só roda com os alvos instalados (`rustup target add x86_64-pc-windows-msvc
# aarch64-apple-darwin`); sem eles, avisa e pula.
outros_sistemas() {
  local instalados alvo crate faltam=()
  instalados="$(rustup target list --installed 2>/dev/null || true)"
  for alvo in x86_64-pc-windows-msvc aarch64-apple-darwin; do
    if ! grep -qx "$alvo" <<<"$instalados"; then
      faltam+=("$alvo")
      continue
    fi
    case "$alvo" in
      *windows*) crate=pet-windows ;;
      *) crate=pet-macos ;;
    esac
    cargo clippy --quiet --target "$alvo" -p pet-core -p "$crate" -p bichinho -- -D warnings || return 1
  done
  if [ "${#faltam[@]}" -gt 0 ]; then
    echo "  (sem os alvos ${faltam[*]}: rustup target add ${faltam[*]})"
  fi
}

# Foto do pet (captura por scripts/capturar-pet.sh: grim no monitor inteiro,
# nunca `grim -g`). Com PET_DEBUG=1 a foto mostra SÓ os pixels opacos do pet
# (máscara = alfa 255 do quadro esperado) sobre um fundo neutro: nada do que
# está atrás dele sai na imagem, e é essa que pode ir para um PR. Sem debug,
# recorta a célula inteira e avisa que a imagem inclui o fundo. A captura do
# monitor inteiro é sempre apagada, até quando algo falha no meio.
FOTO_PASTA=""
foto() {
  local base x y w h
  mkdir -p "$RAIZ/tmp/fotos"
  FOTO_PASTA="$(mktemp -d "$RAIZ/tmp/fotos/.captura-XXXXXX")"
  trap 'rm -rf "${FOTO_PASTA:-}"' EXIT
  if ! "$RAIZ/scripts/capturar-pet.sh" "$FOTO_PASTA"; then
    return 1
  fi
  base="$RAIZ/tmp/fotos/$(date +%Y%m%d-%H%M%S)"
  if [ -f "$FOTO_PASTA/esperado.png" ]; then
    read -r x y w h < <(jq -r '"\(.x) \(.y) \(.w) \(.h)"' "$FOTO_PASTA/quadro.json")
    if ! magick "$FOTO_PASTA/monitor.png" -crop "${w}x${h}+${x}+${y}" +repage \
      \( "$FOTO_PASTA/esperado.png" -alpha extract -threshold 99.9% \) \
      -compose CopyOpacity -composite \
      -background '#202028' -compose Over -flatten "$base.png" ||
      ! magick "$base.png" -filter point -resize 300% "$base-x3.png"; then
      echo "o magick falhou ao montar a foto" >&2
      return 1
    fi
    printf '%s\n%s\n' "$base.png" "$base-x3.png"
  else
    read -r x y w h < <(jq -r '.sprite_disp | "\(.x) \(.y) \(.w) \(.h)"' "$FOTO_PASTA/estado.json")
    if ! magick "$FOTO_PASTA/monitor.png" -crop "${w}x${h}+${x}+${y}" +repage "$base.png"; then
      echo "o magick falhou ao recortar a foto" >&2
      return 1
    fi
    echo "aviso: sem PET_DEBUG a foto inclui o que estiver atrás do pet; não anexe em lugar público" >&2
    printf '%s\n' "$base.png"
  fi
}

# Regra de ouro checável no código (decisões 0006 e 0044): o daemon nunca
# abre o socket de comandos do Hyprland nem chama hyprctl. Olha o código de
# produção de todos os crates, fora de comentários; os testes podem criar um
# `.socket.sock` falso para provar que ninguém conecta.
#
# O awk pula só o item marcado com `#[cfg(test)]` na coluna 0: um `mod x;`
# (uma linha) ou um bloco `… {` até a `}` da coluna 0. Antes ele parava no
# primeiro `#[cfg(test)]` do arquivo, e um `#[cfg(test)] mod testes;` no topo
# escondia o resto (o Motor inteiro). Qualquer outra coisa depois do atributo
# volta a ser lida (melhor um falso alarme que um ponto cego).
linhas_de_producao() {
  # shellcheck disable=SC2016 # é o programa do awk: os $ são do awk
  awk '
    FNR == 1 { pular = 0 }
    pular == 2 { if ($0 ~ /^}/) pular = 0; next }
    pular == 1 {
      if ($0 ~ /^[[:space:]]*#\[/) next
      if ($0 ~ /;[[:space:]]*$/) { pular = 0; next }
      if ($0 ~ /\{[[:space:]]*$/) { pular = 2; next }
      pular = 0
    }
    /^#\[cfg\(test\)\]/ { pular = 1; next }
    { print FILENAME ":" FNR ":" $0 }
  ' "$@"
}

achados_do_socket() {
  linhas_de_producao "$@" |
    grep -E '\.socket\.sock|hyprctl' | grep -vE '^[^:]+:[0-9]+:[[:space:]]*//' || true
}

daemon_sem_socket_de_comandos() {
  local achados arquivos=()
  while IFS= read -r -d '' arquivo; do arquivos+=("$arquivo"); done \
    < <(find crates/*/src -name '*.rs' -print0)
  achados="$(achados_do_socket "${arquivos[@]}")"
  if [ -n "$achados" ]; then
    printf 'o daemon cita o socket de comandos do Hyprland ou o hyprctl:\n%s\n' "$achados" >&2
    return 1
  fi
}

# A guarda de cima se prova a cada verificar: uma linha plantada depois de
# um `#[cfg(test)] mod testes;` no topo e depois de um bloco de teste tem de
# ser achada; a de dentro do bloco de teste, não.
guarda_do_socket_se_prova() {
  local pasta achados ok=0
  pasta="$(mktemp -d)"
  printf '%s\n' '//! Topo.' '#[cfg(test)]' 'mod testes;' '' \
    'fn cedo() { let _ = ".socket.sock"; }' >"$pasta/cedo.rs"
  printf '%s\n' '#[cfg(test)]' '#[allow(dead_code)]' 'mod testes {' \
    '    const S: &str = "/run/hypr/.socket.sock";' '}' '' \
    'fn depois() { let _ = "hyprctl"; }' >"$pasta/bloco.rs"
  achados="$(achados_do_socket "$pasta/cedo.rs" "$pasta/bloco.rs")"
  rm -rf "$pasta"
  grep -q 'cedo.rs:5:' <<<"$achados" || ok=1
  grep -q 'bloco.rs:7:' <<<"$achados" || ok=1
  if grep -q 'bloco.rs:4:' <<<"$achados"; then ok=1; fi
  if [ "$ok" -ne 0 ]; then
    printf 'a guarda do socket de comandos não achou o que devia (ou achou teste):\n%s\n' "$achados" >&2
  fi
  return "$ok"
}

# Decisões 0035 e 0043: nenhum texto do projeto cita o personagem de
# terceiros nem o estúdio dele. Procura sem caixa nos arquivos rastreados e
# nos novos (os ignorados ficam de fora) e nas mensagens dos commits da
# branch que ainda não estão na main; os colchetes fazem o padrão não casar
# consigo mesmo. O corpo do PR se confere antes do `gh pr create`.
NOMES_DE_TERCEIROS='cari[o]ca|dis[n]ey'
sem_nomes_de_terceiros() {
  local achados mensagens=""
  achados="$(git grep --untracked -n -i -E "$NOMES_DE_TERCEIROS" -- . 2>/dev/null || true)"
  if git rev-parse --verify --quiet main >/dev/null; then
    mensagens="$(git log --format='%h %B' main..HEAD 2>/dev/null |
      grep -i -E "$NOMES_DE_TERCEIROS" || true)"
  fi
  if [ -n "$achados" ] || [ -n "$mensagens" ]; then
    printf 'texto citando personagem de terceiros (decisão 0035):\n%s\n' \
      "$achados${mensagens:+$'\n'commits da branch:$'\n'$mensagens}" >&2
    return 1
  fi
}

# Lint de todas as skins da máquina: skins/ (git) e skins-locais/ (packs).
# Avisos não reprovam; erros sim (PLANO.md, `verificar`).
lint_skins() {
  local pastas=() pasta
  for pasta in skins/*/ skins-locais/*/; do
    [ -f "${pasta}skin.json" ] && pastas+=("${pasta%/}")
  done
  [ "${#pastas[@]}" -eq 0 ] && return 0
  cargo xtask lint-skin --so-erros "${pastas[@]}"
}

# A arte livre do Zeca (decisão 0065): o gerador em Python
# (arte/zeca-livre/zeca.py) tem de dar os mesmos bytes a cada execução, e o
# que está no git tem de ser o que sai dele agora. Sem python3, avisa e pula,
# como o shellcheck.
arte_livre_reproduzivel() {
  if ! command -v "${PET_PYTHON:-python3}" >/dev/null 2>&1; then
    echo "  (sem ${PET_PYTHON:-python3}: a conferência da arte livre ficou de fora)"
    return 0
  fi
  cargo xtask zeca-livre --conferir
}

# Caminho absoluto de um argumento (relativo a onde o usuário estava).
absoluto() {
  case "$1" in
    /*) printf '%s' "$1" ;;
    *) printf '%s/%s' "$ORIGEM" "$1" ;;
  esac
}

# Onde ficam as prévias que o Renan olha antes de aprovar (fora do git): as do
# Zeca do pack em tmp/previa-zeca-m2/ e as do Zeca original (decisão 0066) em
# tmp/previa-zeca-livre/.
PREVIAS="tmp/previa-zeca-m2"
PREVIAS_LIVRE="tmp/previa-zeca-livre"

# A pasta das prévias de uma skin, pelo id.
previas_da_skin() {
  case "$1" in
    zeca-livre | zeca-livre-*) printf '%s' "$PREVIAS_LIVRE" ;;
    *) printf '%s' "$PREVIAS" ;;
  esac
}

# skin-instalar <zip|pasta>: o pack Cute Parrots! vira o Zeca em
# skins-locais/ (fora do git, decisão 0011). O zip é lido em memória pelo
# `cargo xtask zeca` (CRC conferido, teto de tamanho, sem extrair nada no
# disco); uma pasta descompactada também serve. Rodar de novo dá o mesmo
# resultado. A arte é montada com --estrito: aviso novo (fora de
# arte/zeca/avisos-aceitos.txt) reprova antes de gravar. A skin só aparece na
# tela depois de `bin/pet subir` (entra na imagem) e de `bin/pet skin-aprovar
# zeca` (decisão 0026).
skin_instalar() {
  local origem variante
  [ "$#" -eq 1 ] || {
    echo "uso: bin/pet skin-instalar <arquivo.zip|pasta do pack>" >&2
    return 2
  }
  origem="$(absoluto "$1")"
  if [ ! -e "$origem" ]; then
    echo "não achei $origem" >&2
    return 1
  fi
  echo "▸ gerando o Zeca (sem e com contorno creme) em skins-locais/"
  for variante in "" --contorno; do
    # shellcheck disable=SC2086 # variante vazia some de propósito
    cargo xtask zeca --estrito --pack "$origem" $variante || return 1
  done
  echo "▸ lint"
  cargo xtask lint-skin skins-locais/zeca skins-locais/zeca-contorno || return 1
  echo "▸ cobertura (os estados do MVP têm de ser nativos)"
  cargo xtask cobertura skins-locais/zeca --nativos mvp || return 1
  echo "▸ prévias"
  for variante in zeca zeca-contorno; do
    cargo xtask contato "skins-locais/$variante" --copia "$PREVIAS" || return 1
  done
  cat <<TEXTO

Pronto. Veja a folha de contato e os GIFs em $RAIZ/$PREVIAS/
(contato-zeca.png sem contorno, contato-zeca-contorno.png com contorno creme;
nos GIFs, fundo escuro à esquerda e claro à direita).
Para o Zeca aparecer na tela:
  1. bin/pet subir                 # a skin entra na imagem local
  2. bin/pet skin-aprovar zeca     # ou zeca-contorno; sem aprovação ele fica escondido
TEXTO
}

# skin-livre: o Zeca original (arte livre, CC0; decisões 0065 e 0066) sai do
# gerador arte/zeca-livre/zeca.py, em skins/ (vai para o git): refaz as duas
# skins (zeca-livre para tema claro e zeca-livre-escuro, com o anel, para tema
# escuro) com os mesmos bytes, roda o lint e a cobertura e põe as folhas de
# contato e os GIFs em tmp/previa-zeca-livre/. Como no pack, a skin só aparece
# na tela depois de `bin/pet subir` e de `bin/pet skin-aprovar <id>`.
skin_livre() {
  [ "$#" -eq 0 ] || {
    echo "uso: bin/pet skin-livre" >&2
    return 2
  }
  local variante
  echo "▸ gerando o Zeca original (arte/zeca-livre/zeca.py) em skins/"
  cargo xtask zeca-livre || return 1
  echo "▸ lint"
  cargo xtask lint-skin skins/zeca-livre skins/zeca-livre-escuro || return 1
  echo "▸ cobertura (os estados do MVP têm de ser nativos)"
  for variante in zeca-livre zeca-livre-escuro; do
    cargo xtask cobertura "skins/$variante" --nativos mvp || return 1
  done
  echo "▸ prévias"
  for variante in zeca-livre zeca-livre-escuro; do
    cargo xtask contato "skins/$variante" --copia "$PREVIAS_LIVRE" || return 1
  done
  cat <<TEXTO

Pronto. Veja a folha de contato e os GIFs em $RAIZ/$PREVIAS_LIVRE/
(contato-zeca-livre-escuro.png para tema escuro, contato-zeca-livre.png para
tema claro; nos GIFs, fundo escuro à esquerda e claro à direita).
Para o Zeca original aparecer na tela:
  1. bin/pet subir                         # as skins entram na imagem
  2. em config/bichinho.toml, na seção [aparencia] (sem criar outra; o tamanho fica):
       [aparencia]
       skin = "zeca-livre-escuro"          # tema escuro; "zeca-livre" no tema claro
  3. bin/pet skin-aprovar zeca-livre-escuro
TEXTO
}

# Impressão digital de uma skin (decisão 0026): o sha256 da saída do
# sha256sum dos três arquivos, na ordem skin.json, dados, folha. O daemon
# calcula igual (pet_core::aprovacao::impressao).
impressao_da_skin() {
  local pasta=$1 dados folha
  dados="$(jq -r .dados "$pasta/skin.json")"
  folha="$(jq -r .folha "$pasta/skin.json")"
  (cd "$pasta" && sha256sum skin.json "$dados" "$folha" | sha256sum | cut -d' ' -f1)
}

# Pasta da skin no host: skins-locais/<id> (packs) ou skins/<id>.
pasta_da_skin() {
  local base
  for base in skins-locais skins; do
    if [ -f "$base/$1/skin.json" ]; then
      printf '%s' "$base/$1"
      return 0
    fi
  done
  return 1
}

# A skin pedida pelo daemon (aparencia.skin), quando o id não vem.
skin_pedida() {
  api /v1/estado | jq -r '.skin.pedida // empty'
}

# skin-aprovar [id]: o Renan aprova o conteúdo exato que viu na folha de
# contato. O host calcula a impressão dos arquivos em skins-locais/<id>; o
# daemon só aprova se a skin da imagem tiver a mesma (senão, falta um
# `bin/pet subir`) e guarda uma cópia aprovada em /state, que segura o
# personagem se a imagem mudar ou quebrar (decisão 0026).
skin_aprovar() {
  local id pasta sha pedida
  id="${1:-}"
  if [ -z "$id" ]; then
    id="$(skin_pedida)" || {
      echo "o pet não respondeu em ${URL} — está de pé? (bin/pet subir)" >&2
      return 1
    }
  fi
  pasta="$(pasta_da_skin "$id")" || {
    echo "não achei a skin «$id» em skins-locais/ nem em skins/ (bin/pet skin-instalar <zip>)" >&2
    return 1
  }
  sha="$(impressao_da_skin "$pasta")"
  # Aprova-se o que foi visto (decisão 0026): a folha de contato traz a
  # impressão digital da skin no título e no contato-<id>.sha256; se a skin
  # mudou depois das prévias, a folha não é mais a que vai para a tela.
  local previas folha vista
  previas="$(previas_da_skin "$id")"
  folha="$previas/contato-$id.png"
  vista="$(cat "$previas/contato-$id.sha256" 2>/dev/null || true)"
  if [ -z "$vista" ]; then
    echo "não achei a folha de contato de «$id» ($folha): gere as prévias e olhe antes de aprovar" >&2
    echo "  (bin/pet skin-instalar <zip> ou bin/pet skin-livre, ou cargo xtask contato $pasta --copia $previas)" >&2
    return 1
  fi
  if [ "$vista" != "$sha" ]; then
    echo "a skin «$id» mudou depois da folha de contato (folha: sha ${vista:0:12}; skin: sha ${sha:0:12})." >&2
    echo "  Gere as prévias de novo e olhe antes de aprovar: cargo xtask contato $pasta --copia $previas" >&2
    return 1
  fi
  echo "aprovando «$id» ($pasta, sha ${sha:0:12}), a da folha $folha"
  if ! comando_pet "$(jq -cn --arg id "$id" --arg sha "$sha" \
    '{cmd: "aprovar_skin", arg: {id: $id, sha256: $sha}}')"; then
    echo "o pet não respondeu em ${URL} — está de pé? (bin/pet subir)" >&2
    return 1
  fi
  if [ "$STATUS" != 200 ]; then
    echo "não aprovou ($STATUS): $(jq -r '.erro // .' <<<"$RESPOSTA" 2>/dev/null || printf '%s' "$RESPOSTA")" >&2
    return 1
  fi
  echo "aprovada: cópia em $(jq -r .snapshot <<<"$RESPOSTA") (volume do pet)"
  jq -r '.personagem | if .id then "personagem: \(.id) (\(.origem))" else "personagem: nenhum — \(.avisos | join("; "))" end' <<<"$RESPOSTA"
  pedida="$(skin_pedida || true)"
  if [ -n "$pedida" ] && [ "$pedida" != "$id" ]; then
    echo "atenção: o pet está configurado para «$pedida»; para usar «$id», ponha" \
      "skin = \"$id\" na seção [aparencia] de config/bichinho.toml (sem criar outra" \
      "[aparencia]; o pet relê o config a cada aprovação) e rode bin/pet skin-aprovar" \
      "$id de novo" >&2
  fi
}

# skin-revogar [id]: tira a aprovação e apaga a cópia de /state.
skin_revogar() {
  local id
  id="${1:-}"
  if [ -z "$id" ]; then
    id="$(skin_pedida)" || {
      echo "o pet não respondeu em ${URL} — está de pé? (bin/pet subir)" >&2
      return 1
    }
  fi
  if ! comando_pet "$(jq -cn --arg id "$id" '{cmd: "revogar_skin", arg: $id}')"; then
    echo "o pet não respondeu em ${URL} — está de pé? (bin/pet subir)" >&2
    return 1
  fi
  if [ "$STATUS" != 200 ]; then
    echo "não revogou ($STATUS): $(jq -r '.erro // .' <<<"$RESPOSTA" 2>/dev/null || printf '%s' "$RESPOSTA")" >&2
    return 1
  fi
  if [ "$(jq -r .revogada <<<"$RESPOSTA")" = true ]; then
    echo "aprovação de «$id» revogada"
  else
    echo "«$id» não estava aprovada"
  fi
  jq -r '.personagem | if .id then "personagem: \(.id) (\(.origem))" else "personagem: nenhum (o pet fica escondido)" end' <<<"$RESPOSTA"
}

# O nome antigo (decisões 0036 e 0041): o projeto do compose era claude-pet,
# com o serviço pet. O container dele segura a porta 27380 e impediria o
# novo de subir: sai (parado e removido), junto com a rede. O volume
# claude-pet_estado, com a aprovação do Zeca, fica: o compose novo usa o
# mesmo, pelo nome.
aposentar_nome_antigo() {
  local antigos
  antigos="$(docker ps -aq --filter label=com.docker.compose.project=claude-pet 2>/dev/null || true)"
  [ -z "$antigos" ] && return 0
  echo "▸ aposentando o container do nome antigo (claude-pet); o volume claude-pet_estado fica"
  # shellcheck disable=SC2086 # um id por palavra
  docker rm -f $antigos >/dev/null
  docker network rm claude-pet_default >/dev/null 2>&1 || true
}

# A worktree estável, de onde o marketplace instala o plugin (README).
ESTAVEL="${PET_ESTAVEL:-$HOME/.local/share/claude-pet/estavel}"

# O commit que o hook do PATH tem de ter: o da worktree estável ou, numa
# máquina sem ela (um clone novo), o da main.
commit_de_referencia() {
  if git -C "$ESTAVEL" rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
    git -C "$ESTAVEL" rev-parse HEAD
  else
    git rev-parse --verify --quiet main || true
  fi
}

# instalar-host: o hook do plugin chama `bichinho avisar` (exec form, decisão
# 0041), então o binário tem de estar no PATH que o Claude Code vê. Copia o
# binário estático (musl) da imagem local para ~/.local/bin/bichinho
# (PET_BIN_HOST muda a pasta), trocando de uma vez, e confere que ele roda no
# host.
#
# Esse binário é a lista branca de TODAS as sessões do Claude Code da máquina
# (decisão 0045): só vai para lá o do commit da worktree estável, de árvore
# limpa, que é o código que o marketplace instalou. A imagem diz de onde saiu
# (etiqueta `bichinho.fonte`, posta pelo `bin/pet subir`), e o binário
# confirma no `bichinho versao`. Para testar uma branch, o binário vai só
# para a sessão (README); `--da-branch` pula a conferência, para uma pasta de
# teste fora do PATH.
instalar_host() {
  local destino="${PET_BIN_HOST:-$HOME/.local/bin}" id pasta achado fonte referencia da_branch=0
  case "${1:-}" in
    "") ;;
    --da-branch) da_branch=1 ;;
    *)
      echo "uso: bin/pet instalar-host [--da-branch]" >&2
      return 2
      ;;
  esac
  if ! docker image inspect bichinho:local >/dev/null 2>&1; then
    echo "falta a imagem bichinho:local: rode bin/pet subir antes" >&2
    return 1
  fi
  fonte="$(docker image inspect bichinho:local \
    --format '{{ index .Config.Labels "bichinho.fonte" }}' 2>/dev/null || true)"
  case "$fonte" in
    '' | '<no value>' | desconhecida) fonte="" ;;
  esac
  referencia="$(commit_de_referencia)"
  if [ "$da_branch" -eq 1 ]; then
    echo "atenção: instalando o binário de ${fonte:-origem desconhecida} sem conferir a worktree estável (--da-branch)." >&2
    echo "  Numa pasta do PATH do Claude Code, ele vale para todas as sessões da máquina." >&2
  elif [ -z "$fonte" ]; then
    echo "a imagem bichinho:local não diz de que commit saiu: refaça com bin/pet subir" >&2
    return 1
  elif [ "$fonte" != "$referencia" ]; then
    echo "a imagem saiu de ${fonte:0:12}, e o hook do PATH tem de ser o de ${referencia:0:12} (a worktree estável, ou a main sem ela)." >&2
    echo "  O hook vale para todas as sessões do Claude Code da máquina (decisão 0045). Depois do merge:" >&2
    echo "  clone e worktree estável na main, bin/pet subir e bin/pet instalar-host (README)." >&2
    echo "  Para testar esta branch só numa sessão:" >&2
    echo "  ~/.cargo/bin/cargo build -p bichinho && PATH=\"\$PWD/target/debug:\$PATH\" claude --plugin-dir plugin" >&2
    return 1
  fi
  mkdir -p "$destino"
  pasta="$(mktemp -d "$destino/.bichinho-XXXXXX")"
  id="$(docker create bichinho:local)"
  if ! docker cp "$id:/usr/local/bin/bichinho" "$pasta/bichinho" >/dev/null; then
    docker rm -f "$id" >/dev/null
    rm -rf "$pasta"
    echo "não consegui copiar o binário da imagem" >&2
    return 1
  fi
  docker rm -f "$id" >/dev/null
  chmod 0755 "$pasta/bichinho"
  if ! "$pasta/bichinho" versao >/dev/null; then
    rm -rf "$pasta"
    echo "o binário da imagem não roda neste host" >&2
    return 1
  fi
  if [ -n "$fonte" ] && ! "$pasta/bichinho" versao | grep -qF "(fonte $fonte)"; then
    rm -rf "$pasta"
    echo "o binário não diz a mesma fonte da etiqueta da imagem ($fonte)" >&2
    return 1
  fi
  mv -f "$pasta/bichinho" "$destino/bichinho"
  rmdir "$pasta"
  echo "instalado: $destino/bichinho ($("$destino/bichinho" versao))"
  achado="$(command -v bichinho 2>/dev/null || true)"
  case ":$PATH:" in
    *":$destino:"*) ;;
    *) echo "atenção: $destino não está no PATH deste shell; o Claude Code precisa achar o bichinho no PATH dele" >&2 ;;
  esac
  if [ -n "$achado" ] && [ "$(readlink -f "$achado")" != "$(readlink -f "$destino/bichinho")" ]; then
    echo "atenção: o PATH acha outro bichinho antes: $achado" >&2
  fi
}

verificar() {
  local falhou=0
  passo() {
    local nome=$1
    shift
    printf '▸ %s\n' "$nome"
    if ! "$@"; then
      printf '✗ %s\n' "$nome" >&2
      falhou=1
    fi
  }
  passo "cargo fmt" cargo fmt --all --check
  passo "pet-core sem Wayland nem sistema (todos os alvos)" core_sem_wayland
  passo "guarda do socket de comandos se prova" guarda_do_socket_se_prova
  passo "daemon sem socket de comandos" daemon_sem_socket_de_comandos
  passo "nomes de terceiros" sem_nomes_de_terceiros
  passo "cargo clippy" cargo clippy --all-targets --quiet -- -D warnings
  passo "cargo test" cargo test --quiet
  passo "Windows e macOS (cargo clippy --target)" outros_sistemas
  passo "lint-skin" lint_skins
  passo "arte livre reproduzível (zeca.py)" arte_livre_reproduzivel
  passo "compose" docker compose config -q
  passo "compose dev" docker compose -f docker-compose.yml -f docker-compose.dev.yml config -q
  if [ -f .claude-plugin/marketplace.json ]; then
    passo "marketplace" claude plugin validate . --strict
  fi
  if [ -f plugin/.claude-plugin/plugin.json ]; then
    passo "plugin" claude plugin validate plugin --strict
  fi
  if command -v shellcheck >/dev/null 2>&1; then
    local scripts=(bin/pet)
    while IFS= read -r -d '' arquivo; do scripts+=("$arquivo"); done \
      < <(find scripts plugin -name '*.sh' -print0 2>/dev/null)
    passo "shellcheck" shellcheck "${scripts[@]}"
  fi
  if [ "$falhou" -eq 0 ]; then
    echo "✓ tudo verde"
  else
    echo "✗ verificação falhou" >&2
    return 1
  fi
}

comando="${1:-ajuda}"
[ "$#" -gt 0 ] && shift

case "$comando" in
  subir)
    aposentar_nome_antigo
    BICHINHO_FONTE="$(fonte_do_clone)" docker compose up -d --build "$@"
    ;;
  parar) docker compose stop "$@" ;;
  logs) docker compose logs -f --tail=100 bichinho ;;
  estado)
    if ! api /v1/estado | jq .; then
      echo "o pet não respondeu em ${URL} — está de pé? (bin/pet subir)" >&2
      exit 1
    fi
    ;;
  testar) testar "$@" ;;
  simular) simular "$@" ;;
  eventos) eventos "$@" ;;
  tocar)
    if [ -z "${1:-}" ]; then
      echo "uso: bin/pet tocar <reação>" >&2
      exit 2
    fi
    tocar_reacao "$1"
    ;;
  clique) clicar_no_pet "$@" ;;
  esconder) comando '{"cmd": "esconder"}' ;;
  mostrar) comando '{"cmd": "mostrar"}' ;;
  foto) foto ;;
  skin-instalar) skin_instalar "$@" ;;
  skin-livre) skin_livre "$@" ;;
  skin-aprovar) skin_aprovar "$@" ;;
  skin-revogar) skin_revogar "$@" ;;
  reconstruir)
    aposentar_nome_antigo
    BICHINHO_FONTE="$(fonte_do_clone)" docker compose build --pull bichinho &&
      docker compose up -d bichinho
    ;;
  dev)
    aposentar_nome_antigo
    BICHINHO_FONTE="$(fonte_do_clone)" \
      docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build
    ;;
  instalar-host) instalar_host "$@" ;;
  verificar) verificar ;;
  ajuda | -h | --help) ajuda ;;
  *)
    echo "comando desconhecido: ${comando}" >&2
    ajuda >&2
    exit 2
    ;;
esac
