#!/usr/bin/env bash
# bin/pet — atalhos do claude-pet. `bin/pet ajuda` lista os comandos.
#
# Funciona de qualquer pasta (resolve a raiz do repo pelo próprio caminho)
# e acrescenta ~/.cargo/bin ao PATH, que fica fora do PATH do Renan.
set -euo pipefail

RAIZ="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# Caminhos relativos dados pelo usuário são relativos a onde ele estava.
ORIGEM="$PWD"
cd "$RAIZ"
export PATH="$HOME/.cargo/bin:$PATH"

# Porta dos hooks: ambiente > .env > padrão.
porta_configurada() {
  if [ -n "${PET_PORTA:-}" ]; then
    printf '%s' "$PET_PORTA"
  elif [ -f .env ] && grep -qE '^PET_PORTA=' .env; then
    grep -E '^PET_PORTA=' .env | tail -n1 | cut -d= -f2-
  else
    printf '27380'
  fi
}
PORTA="$(porta_configurada)"
URL="http://127.0.0.1:${PORTA}"

ajuda() {
  cat <<'TEXTO'
uso: bin/pet <comando>

  subir         sobe o pet (docker compose up -d --build)
  parar         para o pet
  logs          acompanha os logs
  estado        mostra /v1/estado (o que o pet está vendo e pensando)
  foto          foto do pet na tela (grim no monitor inteiro, recorte exato;
                em debug, só os pixels do pet sobre fundo neutro)
  skin-instalar <zip|pasta>
                instala o Zeca a partir do pack Cute Parrots! (descompacta fora
                do repo, gera skins-locais/zeca e zeca-contorno, mostra lint,
                cobertura e as prévias em tmp/previa-zeca-m2/)
  skin-aprovar [id]
                aprova o personagem que você viu na folha de contato (padrão:
                a skin configurada); só vale se a imagem tiver exatamente
                esses arquivos; guarda uma cópia aprovada em /state
  skin-revogar [id]
                tira a aprovação: o pet volta a ficar escondido
  reconstruir   reconstrói a imagem com bases atualizadas e sobe de novo
  dev           modo desenvolvimento em primeiro plano (debug, sem restart)
  verificar     portão antes de todo commit: fmt, clippy, testes, compose, plugin
  ajuda         esta mensagem
TEXTO
}

api() {
  curl -fsS -m 3 -H 'X-Pet: 1' "${URL}$1"
}

# O core é puro (CLAUDE.md): nenhuma dependência normal, direta ou
# transitiva, pode ser crate de Wayland ou do laço de eventos.
core_sem_wayland() {
  local proibidas
  proibidas="$(cargo tree -p pet-core -e normal --prefix none --quiet |
    grep -iE '^(wayland|smithay|calloop)' || true)"
  if [ -n "$proibidas" ]; then
    printf 'pet-core depende de:\n%s\n' "$proibidas" >&2
    return 1
  fi
}

# Foto do pet (captura por scripts/capturar-pet.sh: grim no monitor inteiro,
# nunca `grim -g`). Com PET_DEBUG=1 a foto mostra SÓ os pixels opacos do pet
# (máscara = alfa 255 do quadro esperado) sobre um fundo neutro: nada do que
# está atrás dele sai na imagem, e é essa que pode ir para um PR. Sem debug,
# recorta a célula inteira e avisa que a imagem inclui o fundo. A captura do
# monitor inteiro é sempre apagada, até quando algo falha no meio.
FOTO_PASTA=""
foto() {
  local base x y w h
  mkdir -p "$RAIZ/tmp/fotos"
  FOTO_PASTA="$(mktemp -d "$RAIZ/tmp/fotos/.captura-XXXXXX")"
  trap 'rm -rf "${FOTO_PASTA:-}"' EXIT
  if ! "$RAIZ/scripts/capturar-pet.sh" "$FOTO_PASTA"; then
    return 1
  fi
  base="$RAIZ/tmp/fotos/$(date +%Y%m%d-%H%M%S)"
  if [ -f "$FOTO_PASTA/esperado.png" ]; then
    read -r x y w h < <(jq -r '"\(.x) \(.y) \(.w) \(.h)"' "$FOTO_PASTA/quadro.json")
    if ! magick "$FOTO_PASTA/monitor.png" -crop "${w}x${h}+${x}+${y}" +repage \
      \( "$FOTO_PASTA/esperado.png" -alpha extract -threshold 99.9% \) \
      -compose CopyOpacity -composite \
      -background '#202028' -compose Over -flatten "$base.png" ||
      ! magick "$base.png" -filter point -resize 300% "$base-x3.png"; then
      echo "o magick falhou ao montar a foto" >&2
      return 1
    fi
    printf '%s\n%s\n' "$base.png" "$base-x3.png"
  else
    read -r x y w h < <(jq -r '.sprite_disp | "\(.x) \(.y) \(.w) \(.h)"' "$FOTO_PASTA/estado.json")
    if ! magick "$FOTO_PASTA/monitor.png" -crop "${w}x${h}+${x}+${y}" +repage "$base.png"; then
      echo "o magick falhou ao recortar a foto" >&2
      return 1
    fi
    echo "aviso: sem PET_DEBUG a foto inclui o que estiver atrás do pet; não anexe em lugar público" >&2
    printf '%s\n' "$base.png"
  fi
}

# Regra de ouro checável no código (decisão 0006): o daemon nunca abre o
# socket de comandos do Hyprland nem chama hyprctl. Olha só o código de
# produção (o que vem antes de `#[cfg(test)]`), fora de comentários; os
# testes podem criar um `.socket.sock` falso para provar que ninguém conecta.
daemon_sem_socket_de_comandos() {
  local achados
  achados="$(find crates/claude-pet/src -name '*.rs' -print0 |
    xargs -0 awk '/^#\[cfg\(test\)\]/ {nextfile} {print FILENAME ":" FNR ":" $0}' |
    grep -E '\.socket\.sock|hyprctl' | grep -vE '^[^:]+:[0-9]+:[[:space:]]*//' || true)"
  if [ -n "$achados" ]; then
    printf 'o daemon cita o socket de comandos do Hyprland ou o hyprctl:\n%s\n' "$achados" >&2
    return 1
  fi
}

# Lint de todas as skins da máquina: skins/ (git) e skins-locais/ (packs).
# Avisos não reprovam; erros sim (PLANO.md, `verificar`).
lint_skins() {
  local pastas=() pasta
  for pasta in skins/*/ skins-locais/*/; do
    [ -f "${pasta}skin.json" ] && pastas+=("${pasta%/}")
  done
  [ "${#pastas[@]}" -eq 0 ] && return 0
  cargo xtask lint-skin --so-erros "${pastas[@]}"
}

# Caminho absoluto de um argumento (relativo a onde o usuário estava).
absoluto() {
  case "$1" in
    /*) printf '%s' "$1" ;;
    *) printf '%s/%s' "$ORIGEM" "$1" ;;
  esac
}

# skin-instalar <zip|pasta>: o pack Cute Parrots! vira o Zeca em
# skins-locais/ (fora do git, decisão 0011). O zip é descompactado numa pasta
# temporária fora do repo, apagada no fim. Rodar de novo dá o mesmo resultado.
# A skin só aparece na tela depois de `bin/pet subir` (entra na imagem) e de
# `bin/pet skin-aprovar zeca` (decisão 0026).
PACK_TMP=""
skin_instalar() {
  local origem pack achados variante
  [ "$#" -eq 1 ] || {
    echo "uso: bin/pet skin-instalar <arquivo.zip|pasta do pack>" >&2
    return 2
  }
  origem="$(absoluto "$1")"
  if [ -d "$origem" ]; then
    pack="$origem"
  elif [ -f "$origem" ]; then
    command -v unzip >/dev/null || {
      echo "falta o unzip no host (sudo pacman -S unzip)" >&2
      return 1
    }
    PACK_TMP="$(mktemp -d "${TMPDIR:-/tmp}/claude-pet-pack.XXXXXX")"
    trap 'rm -rf "${PACK_TMP:-}"' EXIT
    if ! unzip -q -o "$origem" -d "$PACK_TMP"; then
      echo "não consegui descompactar $origem (é o zip do pack?)" >&2
      return 1
    fi
    pack="$PACK_TMP"
  else
    echo "não achei $origem" >&2
    return 1
  fi
  achados="$(find "$pack" -path '*/__MACOSX' -prune -o -path '*/Parrot 2/Parrot.aseprite' -print | wc -l)"
  if [ "$achados" -ne 1 ]; then
    echo "layout inesperado: esperava uma pasta «Parrot 2» com Parrot.aseprite (achei $achados) —" >&2
    echo "é o pack Cute Parrots! da exclusiveOlive? https://exclusiveolive.itch.io/cute-parrots-pixel-art-asset-pack" >&2
    return 1
  fi
  echo "▸ gerando o Zeca (sem e com contorno creme) em skins-locais/"
  for variante in "" --contorno; do
    # shellcheck disable=SC2086 # variante vazia some de propósito
    cargo xtask zeca --pack "$pack" $variante || return 1
  done
  echo "▸ lint"
  cargo xtask lint-skin skins-locais/zeca skins-locais/zeca-contorno || return 1
  echo "▸ cobertura"
  cargo xtask cobertura skins-locais/zeca || return 1
  echo "▸ prévias"
  for variante in zeca zeca-contorno; do
    cargo xtask contato "skins-locais/$variante" --copia tmp/previa-zeca-m2 || return 1
  done
  cat <<TEXTO

Pronto. Veja a folha de contato e os GIFs em $RAIZ/tmp/previa-zeca-m2/
(contato-zeca.png sem contorno, contato-zeca-contorno.png com contorno creme).
Para o Zeca aparecer na tela:
  1. bin/pet subir                 # a skin entra na imagem local
  2. bin/pet skin-aprovar zeca     # ou zeca-contorno; sem aprovação ele fica escondido
TEXTO
}

# Impressão digital de uma skin (decisão 0026): o sha256 da saída do
# sha256sum dos três arquivos, na ordem skin.json, dados, folha. O daemon
# calcula igual (pet_core::aprovacao::impressao).
impressao_da_skin() {
  local pasta=$1 dados folha
  dados="$(jq -r .dados "$pasta/skin.json")"
  folha="$(jq -r .folha "$pasta/skin.json")"
  (cd "$pasta" && sha256sum skin.json "$dados" "$folha" | sha256sum | cut -d' ' -f1)
}

# Pasta da skin no host: skins-locais/<id> (packs) ou skins/<id>.
pasta_da_skin() {
  local base
  for base in skins-locais skins; do
    if [ -f "$base/$1/skin.json" ]; then
      printf '%s' "$base/$1"
      return 0
    fi
  done
  return 1
}

# POST /v1/comando; deixa a resposta em RESPOSTA e o status HTTP em STATUS.
RESPOSTA=""
STATUS=""
comando_pet() {
  local saida
  saida="$(curl -sS -m 10 -w '\n%{http_code}' -X POST -H 'X-Pet: 1' \
    -H 'Content-Type: application/json' --data-binary "$1" "${URL}/v1/comando")" || return 1
  STATUS="${saida##*$'\n'}"
  RESPOSTA="${saida%$'\n'*}"
}

# A skin pedida pelo daemon (aparencia.skin), quando o id não vem.
skin_pedida() {
  api /v1/estado | jq -r '.skin.pedida // empty'
}

# skin-aprovar [id]: o Renan aprova o conteúdo exato que viu na folha de
# contato. O host calcula a impressão dos arquivos em skins-locais/<id>; o
# daemon só aprova se a skin da imagem tiver a mesma (senão, falta um
# `bin/pet subir`) e guarda uma cópia aprovada em /state, que segura o
# personagem se a imagem mudar ou quebrar (decisão 0026).
skin_aprovar() {
  local id pasta sha pedida
  id="${1:-}"
  if [ -z "$id" ]; then
    id="$(skin_pedida)" || {
      echo "o pet não respondeu em ${URL} — está de pé? (bin/pet subir)" >&2
      return 1
    }
  fi
  pasta="$(pasta_da_skin "$id")" || {
    echo "não achei a skin «$id» em skins-locais/ nem em skins/ (bin/pet skin-instalar <zip>)" >&2
    return 1
  }
  sha="$(impressao_da_skin "$pasta")"
  echo "aprovando «$id» ($pasta, sha ${sha:0:12}), a da folha tmp/previa-zeca-m2/contato-$id.png"
  if ! comando_pet "$(jq -cn --arg id "$id" --arg sha "$sha" \
    '{cmd: "aprovar_skin", arg: {id: $id, sha256: $sha}}')"; then
    echo "o pet não respondeu em ${URL} — está de pé? (bin/pet subir)" >&2
    return 1
  fi
  if [ "$STATUS" != 200 ]; then
    echo "não aprovou ($STATUS): $(jq -r '.erro // .' <<<"$RESPOSTA" 2>/dev/null || printf '%s' "$RESPOSTA")" >&2
    return 1
  fi
  echo "aprovada: cópia em $(jq -r .snapshot <<<"$RESPOSTA") (volume do pet)"
  jq -r '.personagem | if .id then "personagem: \(.id) (\(.origem))" else "personagem: nenhum — \(.avisos | join("; "))" end' <<<"$RESPOSTA"
  pedida="$(skin_pedida || true)"
  if [ -n "$pedida" ] && [ "$pedida" != "$id" ]; then
    echo "atenção: o pet está configurado para «$pedida»; para usar «$id», ponha" \
      "aparencia.skin = \"$id\" em config/claude-pet.toml e rode bin/pet subir" >&2
  fi
}

# skin-revogar [id]: tira a aprovação e apaga a cópia de /state.
skin_revogar() {
  local id
  id="${1:-}"
  if [ -z "$id" ]; then
    id="$(skin_pedida)" || {
      echo "o pet não respondeu em ${URL} — está de pé? (bin/pet subir)" >&2
      return 1
    }
  fi
  if ! comando_pet "$(jq -cn --arg id "$id" '{cmd: "revogar_skin", arg: $id}')"; then
    echo "o pet não respondeu em ${URL} — está de pé? (bin/pet subir)" >&2
    return 1
  fi
  if [ "$STATUS" != 200 ]; then
    echo "não revogou ($STATUS): $(jq -r '.erro // .' <<<"$RESPOSTA" 2>/dev/null || printf '%s' "$RESPOSTA")" >&2
    return 1
  fi
  if [ "$(jq -r .revogada <<<"$RESPOSTA")" = true ]; then
    echo "aprovação de «$id» revogada"
  else
    echo "«$id» não estava aprovada"
  fi
  jq -r '.personagem | if .id then "personagem: \(.id) (\(.origem))" else "personagem: nenhum (o pet fica escondido)" end' <<<"$RESPOSTA"
}

verificar() {
  local falhou=0
  passo() {
    local nome=$1
    shift
    printf '▸ %s\n' "$nome"
    if ! "$@"; then
      printf '✗ %s\n' "$nome" >&2
      falhou=1
    fi
  }
  passo "cargo fmt" cargo fmt --all --check
  passo "pet-core sem Wayland" core_sem_wayland
  passo "daemon sem socket de comandos" daemon_sem_socket_de_comandos
  passo "cargo clippy" cargo clippy --all-targets --quiet -- -D warnings
  passo "cargo test" cargo test --quiet
  passo "lint-skin" lint_skins
  passo "compose" docker compose config -q
  passo "compose dev" docker compose -f docker-compose.yml -f docker-compose.dev.yml config -q
  if [ -f .claude-plugin/marketplace.json ]; then
    passo "marketplace" claude plugin validate . --strict
  fi
  if [ -f plugin/.claude-plugin/plugin.json ]; then
    passo "plugin" claude plugin validate plugin --strict
  fi
  if command -v shellcheck >/dev/null 2>&1; then
    local scripts=(bin/pet)
    while IFS= read -r -d '' arquivo; do scripts+=("$arquivo"); done \
      < <(find scripts plugin -name '*.sh' -print0 2>/dev/null)
    passo "shellcheck" shellcheck "${scripts[@]}"
  fi
  if [ "$falhou" -eq 0 ]; then
    echo "✓ tudo verde"
  else
    echo "✗ verificação falhou" >&2
    return 1
  fi
}

comando="${1:-ajuda}"
[ "$#" -gt 0 ] && shift

case "$comando" in
  subir) docker compose up -d --build "$@" ;;
  parar) docker compose stop "$@" ;;
  logs) docker compose logs -f --tail=100 pet ;;
  estado)
    if ! api /v1/estado | jq .; then
      echo "o pet não respondeu em ${URL} — está de pé? (bin/pet subir)" >&2
      exit 1
    fi
    ;;
  foto) foto ;;
  skin-instalar) skin_instalar "$@" ;;
  skin-aprovar) skin_aprovar "$@" ;;
  skin-revogar) skin_revogar "$@" ;;
  reconstruir) docker compose build --pull pet && docker compose up -d pet ;;
  dev) docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build ;;
  verificar) verificar ;;
  ajuda | -h | --help) ajuda ;;
  *)
    echo "comando desconhecido: ${comando}" >&2
    ajuda >&2
    exit 2
    ;;
esac
