{
  "description": "Conta ao bichinho (o Zeca, no 127.0.0.1:27380) o que o Claude Code está fazendo: só metadados (evento, ids, ferramenta, contagens, hash do arquivo editado, nome da pasta do projeto). Hooks async em exec form que chamam o binário bichinho no PATH (bichinho avisar <Evento>): sem shell, jq nem curl; nunca imprimem nada e sempre saem 0.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bichinho",
            "args": ["avisar", "SessionStart"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bichinho",
            "args": ["avisar", "UserPromptSubmit"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bichinho",
            "args": ["avisar", "PreToolUse"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bichinho",
            "args": ["avisar", "PostToolUse"]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bichinho",
            "args": ["avisar", "PostToolUseFailure"]
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bichinho",
            "args": ["avisar", "PermissionRequest"]
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|worker_permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bichinho",
            "args": ["avisar", "Notification"]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bichinho",
            "args": ["avisar", "SubagentStart"]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bichinho",
            "args": ["avisar", "PreCompact"]
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bichinho",
            "args": ["avisar", "PostCompact"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bichinho",
            "args": ["avisar", "Stop"]
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bichinho",
            "args": ["avisar", "StopFailure"]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bichinho",
            "args": ["avisar", "SessionEnd"]
          }
        ]
      }
    ]
  }
}
